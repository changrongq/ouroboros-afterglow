# Preserve frozen bytes EXACTLY. Do NOT let git convert line endings here:
# the frozen SPEC / MANIFEST hashes are computed over exact bytes (LF, no BOM,
# exactly one final newline). Any CRLF conversion would invalidate them.

# default: normalize text to LF
* text=auto eol=lf

# frozen objects — never touch their bytes
spec/*.md            -text
prereg/*.md          -text
manifest/*.md        -text
manifest/*.txt       -text
reports/review_history/*.md   -text
artifacts/**/*.json  -text

# source code: LF
*.py   text eol=lf
